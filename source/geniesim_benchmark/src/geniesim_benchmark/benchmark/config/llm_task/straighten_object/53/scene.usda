#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "Objects"
    {
        def Xform "data_collection_table" (
            prepend payload = @/geniesim_assets/objects/benchmark/table/benchmark_table_019/Aligned.usda@
        )
        {
            quatf xformOp:orient = (1, 0, 0, 0)
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (0.01, 0, 0.2609)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            over "entity"
            {
                bool physics:kinematicEnabled = 1
            }
        }

        def Xform "geniesim_2025_target_grasp_object" (
            prepend payload = @/geniesim_assets/objects/benchmark/beverage_bottle/benchmark_beverage_bottle_003/Aligned.usda@
        )
        {
            quatf xformOp:orient = (0.0954584584499, -0.0954584584499, -0.700633772174, 0.700633772174)
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (-0.04, 0.11, 0.853239362761)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            over "entity"
            {
                float physics:mass = 0.05
            }
        }

        def Xform "geniesim_2025_beverage_bottle_001_iros" (
            prepend payload = @/geniesim_assets/objects/iros/beverage_bottle/iros_beverage_bottle_001/Aligned.usda@
        )
        {
            quatf xformOp:orient = (-0.498735038425, 0.498735038425, -0.501261769385, 0.501261769385)
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (-0.02, -0.25, 0.84776552923)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            over "entity"
            {
                float physics:mass = 0.05
            }
        }

        def Xform "geniesim_2025_peach_021" (
            prepend payload = @/geniesim_assets/objects/benchmark/peach/benchmark_peach_021/Aligned.usda@
        )
        {
            quatf xformOp:orient = (0.999761523262, 0, 0, 0.0218379624799)
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (0.04, 0.34, 0.865800000429)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            over "entity"
            {
                float physics:mass = 0.05
            }
        }

    }
}
