#usda 1.0
(
    defaultPrim = "World"
    metersPerUnit = 1
    upAxis = "Z"
)

def "World"
{
    def "Objects"
    {
        def Xform "table_614a6115" (
            prepend payload = @/geniesim_assets/objects/benchmark/table/benchmark_table_019/Aligned.usda@
        )
        {
            over "entity"
            {
                bool physics:kinematicEnabled = 1
            }
            quatf xformOp:orient = (1, 0, 0, 0)
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (0, 0, 0.265)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }

        def Xform "red_block_000" (
            prepend payload = @/geniesim_assets/objects/benchmark/building_blocks/benchmark_building_blocks_074/Aligned.usda@
        )
        {
            quatf xformOp:orient = (0.981342, 0, 0, 0.19227)
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (0.11361, 0.046916, 0.885)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }

        def Xform "black_block_000" (
            prepend payload = @/geniesim_assets/objects/benchmark/building_blocks/benchmark_building_blocks_074/Aligned.usda@
        )
        {
            def Scope "Looks"
            {
                def Material "BlackMaterial"
                {
                    token outputs:surface.connect = </World/Objects/black_block_000/Looks/BlackMaterial/BlackShader.outputs:surface>

                    def Shader "BlackShader"
                    {
                        uniform token info:id = "UsdPreviewSurface"
                        color3f inputs:diffuseColor = (0.01, 0.01, 0.01)
                        float inputs:metallic = 0
                        float inputs:roughness = 0.45
                        token outputs:surface
                    }
                }
            }

            over "entity"
            {
                over "body"
                {
                    over "visual" (
                        prepend apiSchemas = ["MaterialBindingAPI"]
                    )
                    {
                        rel material:binding = </World/Objects/black_block_000/Looks/BlackMaterial>
                    }
                }
            }

            quatf xformOp:orient = (0.982209, 0, 0, -0.187792)
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (0.093525, -0.144701, 0.885)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
        }
    }
}
